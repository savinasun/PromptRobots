<?xml version="1.0" encoding="UTF-8"?>
<robot name="bimanual_ur5e">

  <!-- Common properties -->
  <material name="black">
    <color rgba="0.033 0.033 0.033 1"/>
  </material>
  <material name="jointgray">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>
  <material name="red">
    <color rgba="0.82 0.02 0.02 1"/>
  </material>
  <material name="urblue">
    <color rgba="0.6 0.75 0.85 1"/>
    <luminescence value="0"/>
    <specular value="40"/>
    <specularIntensity value="0.25"/>
  </material>
  <material name="metal">
    <color rgba="0.58 0.58 0.58 1"/>
    <specular value="40"/>
    <specularIntensity value="0.6"/>
  </material>
  <material name="silicone">
    <color rgba="0.1882 0.1882 0.1882 1"/>
  </material>
  <material name="2f85_black">
    <color rgba="0.149 0.149 0.149 1"/>
    <specular value="40"/>
    <specularIntensity value="0.3"/>
  </material>
  <material name="2f85_driver">
    <color rgba="0.9 0.9 0.9 1"/>
  </material>
  <material name="gray">
    <color rgba="0.4627 0.4627 0.4627 1"/>
  </material>
  <material name="linkgray">
    <color rgba="0.82 0.82 0.82 1"/>
    <specular value="100"/>
    <specularIntensity value="1.0"/>
  </material>

  <!-- Base -->
  <link name="bimanual_ur5e">
    <inertial>
        <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
        <mass value="1."/>
        <inertia ixx="1." iyy="1." izz="1." ixy="0." ixz="0." iyz="0."/>
    </inertial>
  </link>

  <!-- Right UR5e -->
