  <!-- Left finger tip link for left gripper -->
  <link name="right_robotiq_85_left_finger_tip_link">
      <visual>
          <geometry>
              <mesh filename="robotiq_meshes/visual/2f_85/left_finger_tip.dae"/>
          </geometry>
      </visual>
      <collision>
          <geometry>
              <mesh filename="robotiq_meshes/collision/2f_85/left_finger_tip.stl"/>
          </geometry>
          <!-- Optional friction/contact settings (Gazebo/ODE-specific) -->
          <surface>
              <friction>
                  <ode>
                      <mu1>100000.0</mu1>
                      <mu2>100000.0</mu2>
                  </ode>
