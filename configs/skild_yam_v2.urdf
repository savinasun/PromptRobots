    <origin xyz="-4.0742e-16 0.0353 0.0395" rpy="-1.5708 3.81639e-16 4.68582e-15"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.0944" upper="2.0944"/>
  </joint>

  <!-- FLU (Front-Left-Up) convention frame: X=forward, Y=left, Z=up
       Derived from MuJoCo tcp_site Rz(-90deg) composed with urdf2standard Ry(+90deg) -->
  <link name="left_ee_flu">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.000001" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
