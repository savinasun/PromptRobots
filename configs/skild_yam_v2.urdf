<?xml version='1.0' encoding='utf-8'?>
<robot name="bimanual_yam">
<!--
  Bimanual YAM URDF for kinematics (no visual/collision meshes).
  Derived from skild-gello: third_party/robot_models/yam/yam.urdf (single-arm)
  and gello/robots/fk_solvers/skild_yam.py (bimanual FK solver).

  Hardware version: v2.x+ (base distance = 0.61 m between arm centers).
  Left arm at origin, right arm offset by -0.61 m in Y.

  FLU end-effector frames derived from:
    - MuJoCo tcp_site: pos=(0,0,0), quat=(1,0,0,-1) → Rz(-90deg) relative to link_6
    - urdf2standard: R=[[0,0,-1],[0,1,0],[1,0,0]] → Ry(+90deg)
    - Combined: rpy="-1.5707963 -1.5707963 0" relative to link_6
-->

  <link name="bimanual_yam">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>

  <!-- ================================================================== -->
  <!-- LEFT ARM                                                           -->
  <!-- ================================================================== -->

  <link name="left_base_link">
    <inertial>
      <origin xyz="-7.22812e-05 2.52572e-05 0.0159932" rpy="0 0 0"/>
      <mass value="0.822546"/>
      <inertia ixx="0.00169415" ixy="2.43507e-07" ixz="-1.31515e-07" iyy="0.00066093" iyz="-9.11171e-07" izz="0.00155626"/>
    </inertial>
  </link>
  <joint name="left_base_joint" type="fixed">
    <parent link="bimanual_yam" />
    <child link="left_base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="left_link_1">
    <inertial>
      <origin xyz="-0.00192861 -0.00795735 0.0208176" rpy="0 0 0"/>
      <mass value="0.12415"/>
      <inertia ixx="5.98038e-05" ixy="-4.5902e-06" ixz="7.411e-06" iyy="0.000169215" iyz="1.68342e-05" izz="0.000156182"/>
    </inertial>
  </link>
  <joint name="left_joint1" type="revolute">
    <parent link="left_base_link"/>
    <child link="left_link_1"/>
    <origin xyz="-3.55271e-18 -1.05495e-18 0.0631" rpy="0 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.61799" upper="3.13"/>
  </joint>

  <link name="left_link_2">
    <inertial>
      <origin xyz="0.132008 2.10599e-06 0.000293073" rpy="0 0 0"/>
      <mass value="1.24434"/>
      <inertia ixx="0.000683304" ixy="1.99503e-09" ixz="3.68337e-09" iyy="0.0121902" iyz="3.20067e-09" izz="0.0121318"/>
    </inertial>
  </link>
  <joint name="left_joint2" type="revolute">
    <parent link="left_link_1"/>
    <child link="left_link_2"/>
    <origin xyz="2.5e-05 -0.02 0.0409" rpy="1.5708 -1.98004e-28 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="0" upper="3.65"/>
