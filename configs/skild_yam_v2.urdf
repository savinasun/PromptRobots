      <mass value="0.60366"/>
      <inertia ixx="0.000955866" ixy="1.47274e-05" ixz="-5.44088e-06" iyy="0.000761363" iyz="0.000106418" izz="0.000508596"/>
    </inertial>
  </link>
  <joint name="left_joint6" type="revolute">
